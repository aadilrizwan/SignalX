# SignalX (.env.example)

# 1. SUPABASE CLOUD (Optional)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=evidence-dossiers

# Next.js Frontend Supabase Client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 2. DATABASE CONNECTION (SQLite for local/container dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./data/SignalX.db

# 3. NEO4J CLOUD (Optional - runs in offline simulation mode if omitted)
NEO4J_URI=
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_DATABASE=

# 4. LLM / AI EVIDENCE GENERATOR (Optional - runs in grounded template mode if omitted)
DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek

# 5. ML MODELS
ML_MODEL_PATH=ml/models/lightgbm_fraud.pkl
ANOMALY_MODEL_PATH=ml/models/isolation_forest.pkl

# 6. RISK THRESHOLDS & COST MATRIX
RISK_THRESHOLD_BLOCK=0.7
RISK_THRESHOLD_REVIEW=0.3
FP_COST=25.0
FN_COST_MULTIPLIER=1.0
REVIEW_COST=5.0

# 7. API SERVER & CORS
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://*.vercel.app,https://*.onrender.com
API_KEY=dev-api-key-change-in-production
SECRET_KEY=change-this-to-a-random-secret-key

