# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./data/SignalX.db

# Redis
REDIS_URL=redis://localhost:6379

# Neo4j
NEO4J_URI=
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# LLM
LLM_API_KEY=
LLM_PROVIDER=mock

# ML Model
ML_MODEL_PATH=ml/models/lightgbm_fraud.pkl
ANOMALY_MODEL_PATH=ml/models/isolation_forest.pkl

# Risk Thresholds
RISK_THRESHOLD_BLOCK=0.7
RISK_THRESHOLD_REVIEW=0.3

# Cost Matrix (USD)
FP_COST=25.0
FN_COST_MULTIPLIER=1.0
REVIEW_COST=5.0

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Security
API_KEY=dev-api-key-change-in-production
SECRET_KEY=change-this-to-a-random-secret-key
